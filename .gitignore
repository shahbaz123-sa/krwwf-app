# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

# --- General ---
*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

# --- Logs ---
*.log
log.txt
npm-debug.log*

# --- IDEs and Editors ---
.idea/
.vscode/
!/.vscode/extensions.json

# --- Node/Ionic ---
/.ionic
/.sass-cache
/.sourcemaps
/.versions
/coverage
/dist
/node_modules
/platforms
/plugins
/www

# --- Laravel ---
/vendor/
/.env
/.env.*
/storage/*.key
/storage/app/public
/public/storage
/bootstrap/cache/

# --- OS/Temp ---
.DS_Store
Thumbs.db
$RECYCLE.BIN/

# --- Others ---
*.bak
*.tmp

# --- Backend Node ---
/backend/node_modules
/backend/dist
/backend/.env
/backend/.env.*

# --- Composer ---
composer.lock

# --- PHPStorm ---
.phpstorm.meta.php

# --- Cypress ---
cypress/videos/
cypress/screenshots/

# --- Misc ---
*.pid

# End of file
