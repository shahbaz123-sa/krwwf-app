<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
  <!--
    Development / local-network configuration.
    This allows cleartext HTTP for private LAN IPs so the APK can reach a locally
    running Laravel server (e.g. http://192.168.x.x:8000).

    NOTE: For production you should remove this and use HTTPS.
  -->
    <base-config cleartextTrafficPermitted="false" />

  <!-- Allow cleartext (http://) traffic to local development hosts/IPs. -->
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="true">localhost</domain>
    <domain includeSubdomains="true">127.0.0.1</domain>
    <domain includeSubdomains="true">10.0.2.2</domain>
    <!-- Example LAN dev server IP (optional). -->
    <domain includeSubdomains="true">192.168.18.36</domain>
  </domain-config>
</network-security-config>

